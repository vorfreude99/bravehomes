# Both are safe to expose to the browser: the anon key is designed for
# it, and row-level security in Supabase is what actually protects data.
# Set these in Vercel under Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe. Without these the donate page still records a pledge, but no
# card is taken. Test keys start sk_test_ / whsec_ / pk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Safe to expose — this is the public counterpart to STRIPE_SECRET_KEY,
# from the same Stripe Dashboard → Developers → API keys page. It is
# what lets the donate page's own card form (not a Stripe-hosted one)
# talk to Stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only, never exposed to the browser. The Stripe webhook uses it
# to mark a pledge paid, which row-level security forbids the client to
# do. Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Realtime TURN. Without these, video calls still work for
# most pairs of people via free STUN — this only matters for calls where
# both sides are behind restrictive ("symmetric") NAT, common on mobile
# data. Server-only: /api/turn uses these to mint a short-lived
# credential per call rather than ever shipping a static key to the
# browser. Cloudflare dashboard → Realtime → TURN → create a key.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_TOKEN=

# A separate token, scoped only to "Account Analytics: Read" (Cloudflare
# dashboard → My Profile → API Tokens → Create Token → Custom Token) —
# deliberately not the same token as CLOUDFLARE_TURN_TOKEN above. Used
# to check *actual* GB relayed this month before ever minting a TURN
# credential: without these two plus CLOUDFLARE_ACCOUNT_ID, /api/turn
# refuses TURN entirely and falls back to STUN-only, rather than spend
# anything it can't verify is still within the free tier.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=

# Optional. How many GB of TURN relay Cloudflare will tolerate this
# month before /api/turn refuses to mint any more credentials. Defaults
# to 900 — a little under Cloudflare's 1,000GB free tier, so there is
# room to notice before anything is ever billed.
CLOUDFLARE_MONTHLY_LIMIT_GB=

# Welcome email on signup. Server-only. resend.com → API Keys. Sending
# "from" an @bravehomes.co.uk address (see lib/email.ts) requires that
# domain to be verified in the Resend dashboard first — without
# verification Resend will reject the send.
RESEND_API_KEY=

# Shared secret between the Supabase database trigger (see
# supabase/migrations/0013_welcome_email_webhook.sql) and
# /api/webhooks/new-account — the only thing verifying a request to that
# endpoint actually came from Supabase and not a stranger who found the
# URL. Must match the value hardcoded into that migration exactly.
SUPABASE_WEBHOOK_SECRET=

# Didit age verification. Without these, /verify-age can't start a
# session and every member is stuck there (see src/proxy.ts) — this is
# not optional the way Stripe is. business.didit.me → API keys for
# DIDIT_API_KEY, and the workflow you configure there (age-estimation
# only, not full KYC) for DIDIT_WORKFLOW_ID.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=

# From the same workflow's webhook settings in the Didit dashboard —
# what /api/webhooks/didit uses to verify a result really came from
# Didit before ever marking someone as age-verified.
DIDIT_WEBHOOK_SECRET=

# Optional: document-based fallback workflow (ID scan, 18+ gate on date
# of birth, selfie-to-portrait match). Used automatically for retries
# after a facial age estimate declines someone.
DIDIT_DOC_WORKFLOW_ID=
